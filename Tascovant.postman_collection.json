      "name": "Free FX sample",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/sample"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
