{
  "info": {
    "name": "Tascovant Data \u2014 public sandbox samples",
    "description": "Public read-only examples. ECB reference rates; no real payments. Full pilot by invitation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
